# =============================================================================
#  অটোপোস্ট কনফিগারেশন  —  এই ফাইলটা কপি করে `.env` বানান, তারপর মান বসান
#  cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------- ১) ইউজারবট
# https://my.telegram.org → API development tools থেকে নিন
# (এই দুটো ছাড়া অন্য চ্যানেল পড়া যাবে না)
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# `autopost login` চালালে data/userbot.session ফাইল তৈরি হবে
USERBOT_SESSION=data/userbot
# অথবা হোস্টিংয়ে ফাইল রাখতে না চাইলে login --string দিয়ে বানানো সেশন বসান
# TG_STRING_SESSION=

# ------------------------------------------------------- ২) যে বট পোস্ট করবে
# @BotFather → /newbot → টোকেন
BOT_TOKEN=123456:AA...
# আপনার চ্যানেল — @username অথবা -1001234567890
TARGET_CHANNEL=@my_channel
# বটকে অবশ্যই চ্যানেলের অ্যাডমিন বানাতে হবে (Post messages পারমিশন)
# আপনার নিজের numeric id (বটকে /start দিলে জানিয়ে দেবে)
OWNER_USER_IDS=123456789
# ড্রাফট কোথায় দেখাবে — খালি থাকলে OWNER_USER_IDS এর প্রথম জনের DM-এ যাবে
# REVIEW_CHAT_ID=

# ------------------------------------------------- ৩) ইনস্পিরেশন সোর্স চ্যানেল
# কমা বা নতুন লাইনে আলাদা করুন।Public চ্যানেলের @username দিন।
SOURCE_CHANNELS=@technews_bd,@world_digest,@example_channel
# কত মিনিট পরপর স্ক্যান করবে
POLL_INTERVAL_MINUTES=30
# প্রতি রানে সর্বোচ্চ কত পোস্ট
MAX_POSTS_PER_RUN=3
# দিনে সর্বোচ্চ কত পোস্ট পাবলিশ হবে
DAILY_POST_LIMIT=12
# সোর্স পোস্টের বয়সসীমা
MIN_SOURCE_AGE_MINUTES=10
MAX_SOURCE_AGE_HOURS=72
# এর চেয়ে ছোট সোর্স পোস্ট বাদ যাবে
MIN_SOURCE_CHARS=120
# ছবি/ভিডিও ছাড়া পোস্ট নেবে না (true করলে)
REQUIRE_MEDIA=false
# এই শব্দগুলো থাকলে বাদ যাবে (কমা দিয়ে)
BLOCKED_KEYWORDS=জুয়া,casino,betting
# একই খবর আবার এলে বাদ দেওয়ার সীমা (0.75 = ভালো ডিফল্ট, কমানো/বাড়ানো যাবে)
DUPLICATE_SIMILARITY_THRESHOLD=0.75
DEDUPE_WINDOW_HOURS=96

# --------------------------------------------------------------- ৪) এআই সেটআপ
# openai → OpenAI বা যেকোনো OpenAI-compatible API (OpenRouter, Groq, DeepSeek, Ollama)
# gemini → Google Gemini
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.8
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
# রিরাইট সোর্সের সাথে এর চেয়ে বেশি মিললে আবার লেখাবে (0.45 = কপি নয়)
MAX_SOURCE_SIMILARITY=0.45
# AI বারবার ফেল করলে টেমপ্লেট দিয়ে পোস্ট করবে কি না
ALLOW_TEMPLATE_FALLBACK=false

# উদাহরণ: Gemini ব্যবহার করতে চাইলে
#   AI_PROVIDER=gemini
#   AI_MODEL=gemini-2.0-flash
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# উদাহরণ: OpenRouter
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=google/gemini-2.0-flash-001

# ------------------------------------------------------------- ৫) চ্যানেল ভয়েস
POST_LANGUAGE=bn
CHANNEL_TITLE=আমার চ্যানেল
CHANNEL_PERSONA=বাংলাভাষী পাঠকদের জন্য তথ্যসমৃদ্ধ, সহজ ও বিশ্বাসযোগ্য কনটেন্ট। ক্লিকবেইট নয়, ক্লিন ও গোছানো লেখা।
# অতিরিক্ত কড়া নিয়ম, প্রতিটা নতুন লাইনে একটা
STYLE_RULES=প্রতিটি পোস্টে সর্বোচ্চ একটি ইমোজি ব্যবহার করবে
STYLE_RULES=টাকার অঙ্ক সবসময় বাংলায় লিখবে
MAX_POST_CHARS=900
HASHTAG_COUNT=3
SIGNATURE=📌 @my_channel
# সোর্সের লিংক দিতে চাইলে true করুন (ডিফল্ট: দেবে না)
INCLUDE_SOURCE_CREDIT=false
SOURCE_CREDIT_TEMPLATE=সূত্র: {link}

# ------------------------------------------------------------- ৬) পাবলিশিং
# false → প্রতিটা পোস্ট আপনার অনুমোদনের পর যাবে (নিরাপদ, সুপারিশকৃত)
# true  → সরাসরি চ্যানেলে যাবে
AUTO_PUBLISH=false
MEDIA_ENABLED=true
MEDIA_MAX_MB=45
# শুধু এই সময়ের মধ্যে পাবলিশ করবে (24h ফরম্যাট, খালি = সবসময়)
# ACTIVE_HOURS_START=9
# ACTIVE_HOURS_END=23
TIMEZONE=Asia/Dhaka
PUBLISH_DELAY_SECONDS=5

# ------------------------------------------------------------------ ৭) অন্যান্য
DATA_DIR=data
LOG_LEVEL=INFO
